NODE_ENV=development
PORT=8000
CORS_ORIGIN=*
PLATFORM_URL=http://localhost:3000
APP_DEEP_LINK_PARENT=kizzo-parent://
APP_DEEP_LINK_ENFANT=kizzo-enfant://

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kizzo?schema=public
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
RESEND_API_KEY=
EMAIL_FROM=Kizzo <no-reply@appstronaute.com>
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=com.appstronaute.kizzo
FCM_SERVICE_ACCOUNT_JSON=

# Cerveau IA — générateur de quiz (clé TOUJOURS côté serveur, jamais dans l'app)
QUIZ_AI_BASE_URL=http://92.222.197.147:8000
QUIZ_AI_API_KEY=
QUIZ_AI_TIMEOUT_MS=10000

# Stripe — abonnements (clés strictement côté serveur)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILLE=
STRIPE_PRICE_FAMILLE_PLUS=
STRIPE_SUCCESS_URL=kizzo-parent://abonnement/succes
STRIPE_CANCEL_URL=kizzo-parent://abonnement/annule

# Jobs de maintenance (planificateur interne). 'false' = déléguer à un cron externe.
MAINTENANCE_JOBS_ENABLED=true
MAINTENANCE_INTERVAL_MS=86400000
