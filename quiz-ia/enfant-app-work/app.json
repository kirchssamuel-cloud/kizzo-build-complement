{
  "expo": {
    "name": "Kizzo Enfant",
    "slug": "kizzo-enfant",
    "scheme": "kizzo-enfant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4C6971"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appstronaute.kizzo.enfant",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appstronaute.kizzo.enfant"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kizzo utilise l'appareil photo pour scanner ton devoir et générer un quiz."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "API_URL": "http://localhost:8000/api"
    }
  }
}
